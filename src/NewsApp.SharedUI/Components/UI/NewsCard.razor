<div class="news-card-wrapper @(_isRead ? "fade-out" : "")">
    <MudCard Elevation="2" Outlined="true" Class="pa-4 mb-4 mud-height-full">
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h6"><b>@Article.Title</b></MudText>
                <MudChip T="string" Color="Color.Primary" Variant="Variant.Text" Size="Size.Small" Class="mt-1">Geral</MudChip>
            </CardHeaderContent>
        </MudCardHeader>
        <MudCardContent>
            <MudText Typo="Typo.body2" Class="news-summary">@Article.Description</MudText>
        </MudCardContent>
        <MudCardActions>
            <MudText Typo="Typo.caption" Color="Color.Secondary">@Article.PublishedAt.ToString("dd/MM/yyyy")</MudText>
            <MudSpacer />
            <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="HandleAccess">Ler Mais</MudButton>
        </MudCardActions>
    </MudCard>
</div>
