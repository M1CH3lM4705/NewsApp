@page "/"

<PageTitle>Home - NewsApp</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-8">
    <div class="hero-section pa-8 rounded-lg mb-8">
        <MudText Typo="Typo.h3" Align="Align.Center" GutterBottom="true" Class="hero-title"><b>Sua dose diária de informação</b></MudText>
        <MudText Typo="Typo.h6" Align="Align.Center" Class="hero-subtitle mb-6">Mantenha-se atualizado com as notícias mais relevantes do dia.</MudText>
        
        <div class="d-flex flex-column align-center gap-4">
            <MudChipSet T="string" SelectionMode="SelectionMode.SingleSelection" SelectedValueChanged="OnCategoryChanged" Color="Color.Primary" Variant="Variant.Text">
                <MudChip Value="@("technology")" Text="Tecnologia" Default="true" />
                <MudChip Value="@("business")" Text="Negócios" />
                <MudChip Value="@("sports")" Text="Esportes" />
                <MudChip Value="@("health")" Text="Saúde" />
                <MudChip Value="@("science")" Text="Ciência" />
            </MudChipSet>

            <div class="d-flex align-center gap-2" style="width: 100%; max-width: 500px;">
                <MudTextField T="string" @bind-Value="_searchQuery" Placeholder="Buscar notícias..." Variant="Variant.Outlined" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" AdornmentColor="Color.Primary" Class="search-input" />
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="OnSearch" Class="rounded-pill px-6">Buscar</MudButton>
            </div>
        </div>
    </div>

    @if (isSyncing && _currentPage == 1)
    {
        <MudStack Spacing="4">
            @for (int i = 0; i < 3; i++)
            {
                <MudCard Elevation="2" Outlined="true" Class="pa-4">
                    <MudSkeleton Width="60%" Height="30px" Class="mb-2" />
                    <MudSkeleton Width="40%" Height="20px" Class="mb-4" />
                    <MudSkeleton Width="100%" Height="60px" />
                </MudCard>
            }
        </MudStack>
    }
    else if (_articles.Any())
    {
        <NewsList Articles="_articles" />
        
        <div class="d-flex justify-center mt-8 mb-12">
            <MudButton Variant="Variant.Outlined" 
                       Color="Color.Primary" 
                       OnClick="LoadMore" 
                       Disabled="@isSyncing"
                       Class="rounded-pill px-8 py-2">
                @if (isSyncing)
                {
                    <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true"/>
                    <MudText Class="ms-2">Carregando...</MudText>
                }
                else
                {
                    <MudText>Carregar Mais</MudText>
                }
            </MudButton>
        </div>
    }
    else if (!isSyncing)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mt-8">
            Nenhuma notícia encontrada para os critérios selecionados.
        </MudAlert>
    }

    <MudScrollToTop>
        <MudFab Color="Color.Primary" StartIcon="@Icons.Material.Filled.ArrowUpward" />
    </MudScrollToTop>
</MudContainer>
