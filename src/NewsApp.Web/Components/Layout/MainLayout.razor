@inherits LayoutComponentBase

<MudThemeProvider @bind-IsDarkMode="@_isDarkMode" Theme="_theme" />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1" Color="Color.Surface">
        <MudText Typo="Typo.h6" Class="ml-3" Color="Color.Primary">NewsApp</MudText>
        <MudSpacer />
        <MudButton Variant="Variant.Text" Href="/" Color="Color.Primary">Novas</MudButton>
        <MudButton Variant="Variant.Text" Href="/lidas" Color="Color.Primary" Class="ml-2">Lidas</MudButton>
        <MudToggleIconButton @bind-Toggled="@_isDarkMode"
                             Icon="@Icons.Material.Filled.DarkMode" Color="@Color.Inherit"
                             ToggledIcon="@Icons.Material.Filled.LightMode" ToggledColor="@Color.Inherit" />
    </MudAppBar>
    <MudMainContent Class="mt-4 px-4">
        @Body
    </MudMainContent>
</MudLayout>

@code {
    private bool _isDarkMode = false;

    private MudTheme _theme = new MudTheme()
    {
        PaletteLight = new PaletteLight()
        {
            Primary = "#594AE2",
            Background = "#F7F8FA",
            AppbarBackground = "#FFFFFF",
            Surface = "#FFFFFF",
            DrawerBackground = "#FFFFFF",
            TextPrimary = "#2D2D2D",
        },
        PaletteDark = new PaletteDark()
        {
            Primary = "#594AE2",
            Background = "#1E1E2D",
            AppbarBackground = "#1E1E2D",
            Surface = "#2D2D3B",
            TextPrimary = "#F0F0F0",
        },
        Typography = new Typography()
        {
            Default = new DefaultTypography()
            {
                FontFamily = new[] { "Roboto", "Inter", "Helvetica", "Arial", "sans-serif" }
            }
        }
    };
}
