@using Microsoft.AspNetCore.Components.Routing
@using NewsApp.SharedUI.Components

<Router AppAssembly="@typeof(Main).Assembly" AdditionalAssemblies="new[] { typeof(NewsApp.SharedUI.Components.Pages.Home).Assembly }">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(NewsApp.SharedUI.Components.Layout.MainLayout)" />
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
    <NotFound>
        <LayoutView Layout="@typeof(NewsApp.SharedUI.Components.Layout.MainLayout)">
            <p role="alert">Desculpe, não há nada neste endereço.</p>
        </LayoutView>
    </NotFound>
</Router>
