<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<TargetFrameworks>net9.0-android</TargetFrameworks>
		<OutputType>Exe</OutputType>
		<RootNamespace>NewsApp.Mobile</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Identidade do App -->
		<ApplicationTitle>NewsApp</ApplicationTitle>
		<ApplicationId>com.companyname.newsapp</ApplicationId>
		<ApplicationIdGuid>f7b1e4c2-0cf3-4f50-a148-e3c7c5aab2e8</ApplicationIdGuid>
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">23.0</SupportedOSPlatformVersion>
		
		<!-- Otimização de Build -->
		<PublishTrimmed>true</PublishTrimmed>
		<TrimMode>full</TrimMode>
	</PropertyGroup>

	<!-- Configuração de Segurança: Variáveis Embutidas -->
	<ItemGroup>
		<EmbeddedResource Include="appsettings.production.json" Condition="Exists('appsettings.production.json')" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="9.0.0" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="9.0.0" />
		<PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="9.0.0" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="9.0.0" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="9.0.0" />
		<PackageReference Include="MudBlazor" Version="9.3.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\NewsApp.Application\NewsApp.Application.csproj" />
		<ProjectReference Include="..\NewsApp.Infrastructure\NewsApp.Infrastructure.csproj" />
		<ProjectReference Include="..\NewsApp.SharedUI\NewsApp.SharedUI.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="..\NewsApp.Web\wwwroot\**" Link="wwwroot\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

</Project>
